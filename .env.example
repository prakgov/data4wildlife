# Copy to .env and fill in. .env is gitignored; never commit real keys.

# RapidAPI (Instagram data source)
RAPIDAPI_KEY=
RAPIDAPI_HOST=instagram85.p.rapidapi.com

# Google Cloud Translation API v2
GOOGLE_TRANSLATE_API_KEY=
TRANSLATE_TARGET_LANG=en

# Where the backend stores the SQLite DB and downloaded media
DATA_DIR=data
